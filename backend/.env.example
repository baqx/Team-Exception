d # Application Configuration
APP_NAME="Chalkka Backend API"
APP_ENV=development
PORT=8000
DEBUG=True

# Pluggable Provider Selection
# AI Provider: "gemini" or "mock"
AI_PROVIDER=gemini

# TTS Provider: "edge" (free local natural voice) or "google" or "mock"
TTS_PROVIDER=edge

# Storage Provider: "local" (serves from static/) or "cloudinary"
STORAGE_PROVIDER=local

# Google Gemini API Key
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Edge-TTS Voice Name (e.g. en-US-ChristopherNeural or en-US-GuyNeural)
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Cloudinary (Optional - for production CDN video streaming)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
