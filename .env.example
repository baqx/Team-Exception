# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ==============================================================================
# URL of the deployed Render backend (e.g. https://chalkka-backend.onrender.com)
NEXT_PUBLIC_API_URL=https://chalkka-backend.onrender.com
BACKEND_URL=https://chalkka-backend.onrender.com
NEXT_PUBLIC_APP_URL=https://chalkka.vercel.app

# Supabase Auth & Database (Frontend Public)
NEXT_PUBLIC_SUPABASE_URL=https://blkqcpejalvzlszkgxes.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Render)
# ==============================================================================
# Port provided automatically by Render ($PORT)
PORT=8000
APP_ENV=production
DEBUG=false

# AI Provider (Gemini 2.5/Flash)
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Audio / TTS Engine (Default: edge-tts for calm academic neural voice)
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Cloudinary Storage & CDN
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Allowed Frontend Origins (CORS)
FRONTEND_URL=https://chalkka.vercel.app
